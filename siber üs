/* ---------------- STATE / STORAGE ---------------- */
const STORAGE_KEY = 'siberus_progress_v1';
function loadProgress(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : {};
  }catch(e){ return {}; }
}
function saveProgress(p){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(p)); }catch(e){}
}
let progress = loadProgress();

const SCEN_KEY = 'siberus_scenarios_v1';
function loadScenarioProgress(){
  try{ const raw = localStorage.getItem(SCEN_KEY); return raw ? JSON.parse(raw) : {}; }catch(e){ return {}; }
}
function saveScenarioProgress(p){ try{ localStorage.setItem(SCEN_KEY, JSON.stringify(p)); }catch(e){} }
let scenarioProgress = loadScenarioProgress();

const RISK_KEY = 'siberus_risk_v1';
function loadRiskResult(){
  try{ const raw = localStorage.getItem(RISK_KEY); return raw ? JSON.parse(raw) : null; }catch(e){ return null; }
}
function saveRiskResult(r){ try{ localStorage.setItem(RISK_KEY, JSON.stringify(r)); }catch(e){} }

function isDone(id){
  const p = progress[id];
  return !!p && (p===true || p.done);
}
function getScore(id){
  const p = progress[id];
  if(p && typeof p==='object' && typeof p.total==='number') return {score:p.score, total:p.total};
  return null;
}
function completedCount(){
  return MODULES.filter(m=>isDone(m.id)).length;
}
function isPerfect(id){
  const s = getScore(id);
  return !!s && s.total>0 && s.score===s.total;
}

