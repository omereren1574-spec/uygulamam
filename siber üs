    + '</div>'
    + '<div id="outcomeArea"></div>'
    + '<div class="scenario-nav" id="scenarioNavRow"></div>';
  document.getElementById('scenarioDetailContent').innerHTML = html;
  showPage('scenario-detail');

  document.querySelectorAll('#choiceList .choice-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const ci = parseInt(btn.dataset.ci,10);
      const choice = s.choices[ci];
      document.querySelectorAll('#choiceList .choice-btn').forEach(b=>b.disabled=true);
      document.getElementById('outcomeArea').innerHTML =
        '<div class="outcome-panel '+choice.level+'">'
          + '<span class="outcome-tag">'+(choice.level==='good'?'EN GÜVENLİ SEÇİM':choice.level==='ok'?'DİKKATLİ AMA İDEAL DEĞİL':'RİSKLİ SEÇİM')+'</span>'
          + '<p>'+choice.outcome+'</p>'
        + '</div>';
      scenarioProgress[s.id] = true;
      saveScenarioProgress(scenarioProgress);
      updateFooter();
      const nextS = SCENARIOS[idx+1];
      document.getElementById('scenarioNavRow').innerHTML = nextS
        ? '<button class="btn" id="nextScenarioBtn">Sonraki senaryo →</button><span></span>'
        : '<button class="btn secondary" id="doneScenarioBtn">Senaryolara dön</button><span></span>';
      if(nextS) document.getElementById('nextScenarioBtn').addEventListener('click', ()=>openScenario(nextS.id));
      const doneBtn = document.getElementById('doneScenarioBtn');
      if(doneBtn) doneBtn.addEventListener('click', ()=>showPage('scenarios'));
    });
  });
}

/* ---------------- RISK TEST ---------------- */
function riskLevelFor(score, max){
  const ratio = score/max;
  if(ratio >= 0.7) return 'low';
  if(ratio >= 0.4) return 'medium';
  return 'high';
}
const RISK_LEVEL_LABEL = {low:'Düşük risk', medium:'Orta risk', high:'Yüksek risk'};

function renderRiskPage(){
  renderRiskIntroAndQuiz();
}

function renderRiskIntroAndQuiz(){
  const area = document.getElementById('riskArea');
  area.innerHTML = ''
    + '<div class="risk-intro"><p>Dürüstçe cevapla — bu bir sınav değil, sadece nerede olduğunu görmen için bir ayna.</p></div>'
    + RISK_QUESTIONS.map((q,qi)=>(
      '<div class="q-block" data-rqi="'+qi+'">'
        + '<p class="q-prompt">'+(qi+1)+'. '+q.q+'</p>'
        + '<div class="q-options">'
          + q.options.map((opt,oi)=>(
            '<label class="q-option" data-oi="'+oi+'">'
            + '<input type="radio" name="rq'+qi+'" value="'+oi+'"> <span>'+opt.t+'</span>'
            + '</label>'
          )).join('')
        + '</div>'
      + '</div>'
    )).join('')
    + '<div class="quiz-actions"><button class="btn" id="riskSubmitBtn">Sonucu Gör</button><span class="quiz-score" id="riskWarn"></span></div>';

  document.getElementById('riskSubmitBtn').addEventListener('click', computeRisk);
}

function computeRisk(){
  let total = 0;
  let allAnswered = true;
  const weakModuleIds = [];
  RISK_QUESTIONS.forEach((q,qi)=>{
    const block = document.querySelector('.q-block[data-rqi="'+qi+'"]');
    const checked = block.querySelector('input[name="rq'+qi+'"]:checked');
    if(!checked){ allAnswered = false; return; }
    const oi = parseInt(checked.value,10);
    const pts = q.options[oi].p;
    total += pts;
    if(pts<=1 && weakModuleIds.indexOf(q.module)===-1) weakModuleIds.push(q.module);
  });
  if(!allAnswered){
    document.getElementById('riskWarn').textContent = 'Lütfen tüm soruları işaretle.';
    return;
  }
  const max = RISK_QUESTIONS.length*3;
  const level = riskLevelFor(total, max);
  saveRiskResult({score:total, max:max, level:level, weak:weakModuleIds, date:Date.now()});
  updateFooter();
  renderRiskResult(total, max, level, weakModuleIds);
}

function renderRiskResult(score, max, level, weakModuleIds){
  const area = document.getElementById('riskArea');
  const pct = Math.round(score/max*100);
  const summaryText = level==='low'
    ? 'Genel olarak sağlam dijital alışkanlıklara sahipsin. Yine de zayıf kalan alanları tazelemek iyi olur.'
    : level==='medium'
    ? 'Bazı iyi alışkanlıkların var, ama birkaç alanda risk taşıyorsun. Aşağıdaki modüllerle bu boşlukları kapatabilirsin.'
    : 'Şu an bazı temel alışkanlıklarda ciddi risk taşıyorsun. İyi haber: aşağıdaki modüllerle bunu hızla değiştirebilirsin.';
  const weakModules = MODULES.filter(m=>weakModuleIds.includes(m.id));
  area.innerHTML = ''
    + '<div class="risk-result">'
      + '<div class="risk-result-head"><span class="risk-score">'+score+' / '+max+'</span><span class="risk-level-tag '+level+'">'+RISK_LEVEL_LABEL[level]+'</span></div>'
      + '<div class="risk-gauge-track"><div class="risk-gauge-fill '+level+'" style="width:'+pct+'%;"></div></div>'
      + '<p class="summary">'+summaryText+'</p>'
      + (weakModules.length
          ? '<p class="weak-list-head">Sana özel önerilen modüller</p>'
            + '<div class="path" style="position:relative;">'
              + weakModules.map(m=>(
                '<div class="path-item card" data-open="'+m.id+'" style="margin-bottom:12px;">'
                  + '<div class="card-main">'+icon(m.icon)+'<div><h3>'+m.title+'</h3><p>'+m.summary+'</p></div></div>'
                  + '<button class="open-btn" data-open="'+m.id+'">Aç</button>'
                + '</div>'
              )).join('')
            + '</div>'
          : '<p class="weak-list-head">Belirgin bir zayıf alan görünmüyor — tebrikler!</p>')
      + '<div class="risk-actions"><button class="btn secondary" id="retakeRiskBtn">Testi tekrar al</button></div>'
    + '</div>';
  area.querySelectorAll('[data-open]').forEach(node=>{
    node.addEventListener('click', ()=>openModule(node.dataset.open));
  });
  document.getElementById('retakeRiskBtn').addEventListener('click', renderRiskIntroAndQuiz);
}

function updateFooter(){
  document.getElementById('footerProgress').textContent = completedCount()+' / '+MODULES.length+' modül tamam';
}

/* ---------------- INIT ---------------- */
renderModuleList();
updateFooter();
</script>
