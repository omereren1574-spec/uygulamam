function renderProgressPage(){
  const count = completedCount();
  document.getElementById('progressCount').textContent = count+' / '+MODULES.length;
  document.getElementById('progressFill').style.width = (count/MODULES.length*100)+'%';
  const list = document.getElementById('progressList');
  list.innerHTML = MODULES.map((m,i)=>{
    const done = isDone(m.id);
    const score = getScore(m.id);
    const scoreText = score ? ' ('+score.score+'/'+score.total+')' : '';
    return '<div class="progress-row">'
      + '<div class="left"><div class="mark'+(done?' done':'')+'">'+(done?'✓':(i+1))+'</div><span class="title">'+m.title+'</span></div>'
      + '<span class="status">'+(done?'Tamamlandı'+scoreText:'Bekliyor')+'</span>'
    + '</div>';
  }).join('');

  const unlocked = unlockedBadges().map(b=>b.id);
  document.getElementById('badgesGrid').innerHTML = BADGES.map(b=>{
    const on = unlocked.includes(b.id);
    return '<div class="badge-card'+(on?' unlocked':' locked')+'">'
      + '<div class="badge-icon">'+icon(b.icon)+'</div>'
      + '<h4>'+b.title+'</h4><p>'+b.desc+'</p>'
    + '</div>';
  }).join('');

  renderCertTeaser();
}

