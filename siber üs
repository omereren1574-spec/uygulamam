function renderQuestion(q, qi){
  return '<div class="q-block" data-qi="'+qi+'">'
    + '<p class="q-prompt">'+(qi+1)+'. '+q.q+'</p>'
    + '<div class="q-options">'
      + q.options.map((opt,oi)=>(
        '<label class="q-option" data-oi="'+oi+'">'
        + '<input type="radio" name="q'+qi+'" value="'+oi+'"> <span>'+opt+'</span>'
        + '</label>'
      )).join('')
    + '</div>'
    + '<p class="q-feedback" data-fb="'+qi+'"></p>'
  + '</div>';
}

function gradeQuiz(m){
  let score = 0;
  let answeredAll = true;
  m.quiz.forEach((q,qi)=>{
    const block = document.querySelector('.q-block[data-qi="'+qi+'"]');
    const checked = block.querySelector('input[name="q'+qi+'"]:checked');
    const fb = document.querySelector('.q-feedback[data-fb="'+qi+'"]');
    block.querySelectorAll('.q-option').forEach(o=>o.classList.remove('correct','wrong'));
    if(!checked){ answeredAll = false; return; }
    const chosen = parseInt(checked.value,10);
    const correctOpt = block.querySelector('.q-option[data-oi="'+q.correct+'"]');
    correctOpt.classList.add('correct');
    if(chosen === q.correct){
      score++;
    } else {
      block.querySelector('.q-option[data-oi="'+chosen+'"]').classList.add('wrong');
    }
    fb.textContent = q.explain;
    fb.classList.add('show');
  });
  const scoreEl = document.getElementById('quizScore');
  if(!answeredAll){
    scoreEl.textContent = 'Lütfen tüm soruları işaretle.';
    return;
  }
  scoreEl.textContent = 'Skor: '+score+' / '+m.quiz.length;
  progress[m.id] = {done:true, score:score, total:m.quiz.length};
  saveProgress(progress);
  document.getElementById('completeNote').classList.add('show');
  updateFooter();
}

