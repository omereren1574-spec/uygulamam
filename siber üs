/* ---------------- RENDER: MODULE LIST ---------------- */
function normalize(s){
  return (s||'').toLocaleLowerCase('tr').replace(/i̇/g,'i');
}
function moduleMatches(m, term){
  if(!term) return true;
  const haystack = normalize([m.title, m.summary, m.sections.join(' '), m.keyPoints.join(' ')].join(' '));
  return haystack.includes(normalize(term));
}
function renderModuleList(){
  const term = (document.getElementById('searchInput')||{value:''}).value;
  const el = document.getElementById('pathList');
  const emptyEl = document.getElementById('searchEmpty');
  const visible = MODULES.filter(m=>moduleMatches(m, term));
  el.classList.toggle('hide', visible.length===0);
  if(emptyEl) emptyEl.classList.toggle('hide', visible.length!==0);
  el.innerHTML = '<div class="path-line"></div>' + visible.map((m)=>{
    const i = MODULES.indexOf(m);
    const done = isDone(m.id);
    return '<div class="path-item">'
      + '<div class="node'+(done?' done':'')+'">'+(done?'✓':String(i+1).padStart(2,'0'))+'</div>'
      + '<div class="path-item card" data-open="'+m.id+'">'
        + '<div class="card-main">'+icon(m.icon)+'<div><h3>'+m.title+'</h3><p>'+m.summary+'</p></div></div>'
        + '<div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;">'
          + '<span class="card-status'+(done?' done':'')+'">'+(done?'Tamamlandı':'Başlanmadı')+'</span>'
          + '<button class="open-btn" data-open="'+m.id+'">'+(done?'Tekrar aç':'Aç')+'</button>'
        + '</div>'
      + '</div>'
    + '</div>';
  }).join('');
  el.querySelectorAll('[data-open]').forEach(node=>{
    node.addEventListener('click', ()=>openModule(node.dataset.open));
  });
}
document.addEventListener('input', (e)=>{
  if(e.target && e.target.id==='searchInput') renderModuleList();
});

