<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Siber Üs — Sıfırdan Siber Güvenlik</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#101B24;
  --surface-dark:#16232F;
  --surface-dark-2:#1D2C3A;
  --paper:#F3F5F3;
  --paper-2:#E6EAE7;
  --line:#C9D2CC;
  --line-strong:#9DA9A3;
  --text:#101B24;
  --text-muted:#4A585F;
  --text-on-dark:#EDF1EE;
  --text-on-dark-muted:#9FB0AA;
  --signal:#2FAE76;
  --signal-soft:#E3F3EA;
  --amber:#C98A22;
  --amber-soft:#F6ECD8;
  --danger:#B4402A;
  --danger-soft:#F5E2DC;
  --radius:3px;
  --mono:'IBM Plex Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
  --sans:'IBM Plex Sans', -apple-system, 'Segoe UI', Roboto, sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --ink:#EDF1EE;
    --paper:#0F171D;
    --paper-2:#182229;
    --line:#2B3841;
    --line-strong:#455158;
    --text:#EDF1EE;
    --text-muted:#9FB0AA;
    --surface-dark:#0B1116;
    --surface-dark-2:#131C22;
    --signal-soft:#173226;
    --amber-soft:#332608;
    --danger-soft:#331611;
  }
}
:root[data-theme="dark"]{
  --ink:#EDF1EE;
  --paper:#0F171D;
  --paper-2:#182229;
  --line:#2B3841;
  --line-strong:#455158;
  --text:#EDF1EE;
  --text-muted:#9FB0AA;
  --surface-dark:#0B1116;
  --surface-dark-2:#131C22;
  --signal-soft:#173226;
  --amber-soft:#332608;
  --danger-soft:#331611;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--paper);
  color:var(--text);
  font-family:var(--sans);
  font-size:16px;
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
}
img,svg{max-width:100%;display:block;}
button{font-family:inherit;cursor:pointer;}
a{color:inherit;}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px;}
.hide{display:none !important;}

/* ---------- NAV ---------- */
header.site{
  position:sticky;top:0;z-index:50;
  background:var(--paper);
  border-bottom:1px solid var(--line);
}
.nav-inner{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 24px;max-width:1120px;margin:0 auto;
}
.logo{
  font-family:var(--mono);font-weight:600;font-size:16px;letter-spacing:0.02em;
  display:flex;align-items:center;gap:8px;
}
.logo .dot{width:8px;height:8px;border-radius:50%;background:var(--signal);display:inline-block;}
nav.links{display:flex;gap:22px;font-family:var(--mono);font-size:13.5px;flex-wrap:wrap;}
nav.links button{
  background:none;border:none;color:var(--text-muted);padding:6px 0;
  border-bottom:2px solid transparent;font-size:13.5px;
}
nav.links button.active{color:var(--text);border-bottom-color:var(--signal);}
.burger{display:none;background:none;border:1px solid var(--line);padding:8px 10px;border-radius:var(--radius);}
.burger span{display:block;width:18px;height:2px;background:var(--text);margin:4px 0;}
@media (max-width:760px){
  nav.links{
    position:absolute;top:64px;left:0;right:0;background:var(--paper);
    flex-direction:column;gap:0;border-bottom:1px solid var(--line);
    max-height:0;overflow:hidden;transition:max-height .25s ease;
  }
  nav.links.open{max-height:260px;}
  nav.links button{padding:14px 24px;border-bottom:1px solid var(--line);width:100%;text-align:left;border-left:2px solid transparent;}
  nav.links button.active{border-left-color:var(--signal);border-bottom-color:var(--line);}
  .burger{display:block;}
}

/* ---------- HERO ---------- */
.hero{padding:72px 0 56px;border-bottom:1px solid var(--line);}
.hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:56px;align-items:center;}
@media (max-width:860px){.hero-grid{grid-template-columns:1fr;gap:36px;}}
.eyebrow-line{
  font-family:var(--mono);font-size:13px;color:var(--text-muted);
  margin:0 0 18px;display:flex;align-items:center;gap:10px;
}
.eyebrow-line .dot{width:6px;height:6px;background:var(--signal);border-radius:50%;}
h1.hero-title{
  font-family:var(--mono);font-weight:600;font-size:clamp(32px,5vw,52px);
  line-height:1.08;letter-spacing:-0.01em;margin:0 0 22px;max-width:14ch;
}
.hero p.lead{font-size:18px;color:var(--text-muted);max-width:42ch;margin:0 0 30px;}
.cta-row{display:flex;gap:14px;flex-wrap:wrap;}
.btn{
  font-family:var(--mono);font-size:14px;padding:13px 22px;border-radius:var(--radius);
  border:1px solid var(--ink);background:var(--ink);color:var(--paper);
  display:inline-flex;align-items:center;gap:8px;
}
.btn.secondary{background:transparent;color:var(--text);border:1px solid var(--line-strong);}
.btn:hover{opacity:.88;}
.hero-art{width:100%;}

/* principles strip */
.principles{border-bottom:1px solid var(--line);}
.principles .wrap{display:grid;grid-template-columns:repeat(3,1fr);}
@media (max-width:760px){.principles .wrap{grid-template-columns:1fr;}}
.principle{
  padding:34px 26px;border-left:1px solid var(--line);
}
.principle:first-child{border-left:none;}
@media (max-width:760px){
  .principle{border-left:none;border-top:1px solid var(--line);}
  .principle:first-child{border-top:none;}
}
.principle svg{width:26px;height:26px;color:var(--signal);margin-bottom:14px;}
.principle h3{font-family:var(--mono);font-size:15px;margin:0 0 8px;font-weight:600;}
.principle p{color:var(--text-muted);font-size:14.5px;margin:0;max-width:32ch;}

/* ---------- SECTION HEADERS ---------- */
.section{padding:64px 0;}
.section-head{margin-bottom:40px;}
.section-head h2{
  font-family:var(--mono);font-size:clamp(22px,3vw,30px);font-weight:600;margin:0 0 10px;
}
.section-head p{color:var(--text-muted);max-width:50ch;margin:0;font-size:15.5px;}

/* ---------- MODULE PATH ---------- */
.path{position:relative;}
.path-line{
  position:absolute;left:23px;top:14px;bottom:14px;width:1px;background:var(--line);
}
@media (max-width:600px){.path-line{left:19px;}}
.path-item{
  position:relative;display:flex;gap:22px;padding:0 0 34px;
}
.path-item:last-child{padding-bottom:0;}
.node{
  position:relative;z-index:1;flex:0 0 auto;width:48px;height:48px;border-radius:50%;
  border:1px solid var(--line-strong);background:var(--paper);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--mono);font-size:13px;color:var(--text-muted);
}
@media (max-width:600px){.node{width:40px;height:40px;font-size:11.5px;}}
.node.done{background:var(--signal);border-color:var(--signal);color:#fff;}
.path-item.card{
  flex:1;border:1px solid var(--line);border-radius:var(--radius);
  padding:22px 24px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;
  background:var(--paper);transition:border-color .15s ease;
}
.path-item.card:hover{border-color:var(--line-strong);}
.card-main{display:flex;gap:16px;align-items:flex-start;}
.card-main svg{width:22px;height:22px;color:var(--text-muted);flex:0 0 auto;margin-top:2px;}
.card-main h3{font-family:var(--mono);font-size:16px;margin:0 0 6px;font-weight:600;}
.card-main p{color:var(--text-muted);font-size:14px;margin:0;max-width:46ch;}
.card-status{font-family:var(--mono);font-size:12px;color:var(--text-muted);white-space:nowrap;padding-top:4px;}
.card-status.done{color:var(--signal);}
.open-btn{
  font-family:var(--mono);font-size:13px;padding:9px 16px;border:1px solid var(--line-strong);
  border-radius:var(--radius);background:transparent;flex:0 0 auto;white-space:nowrap;
}
.open-btn:hover{background:var(--paper-2);}
@media (max-width:640px){
  .path-item.card{flex-direction:column;}
  .open-btn{align-self:flex-start;}
}

/* ---------- MODULE DETAIL ---------- */
.detail-head{display:flex;align-items:center;gap:14px;margin-bottom:30px;flex-wrap:wrap;}
.back-btn{
  font-family:var(--mono);font-size:13px;background:none;border:none;color:var(--text-muted);
  padding:6px 0;display:flex;align-items:center;gap:6px;
}
.detail-title-row{display:flex;align-items:center;gap:14px;margin:26px 0 8px;}
.detail-title-row svg{width:30px;height:30px;color:var(--signal);}
.detail-title-row h2{font-family:var(--mono);font-size:26px;margin:0;font-weight:600;}
.detail-num{font-family:var(--mono);color:var(--text-muted);font-size:14px;}
article.lesson{max-width:68ch;}
article.lesson p{font-size:16px;margin:0 0 18px;color:var(--text);}
.keypoints{
  border:1px solid var(--line);border-radius:var(--radius);padding:22px 24px;margin:28px 0 8px;
  background:var(--paper-2);
}
.keypoints h4{font-family:var(--mono);font-size:13px;margin:0 0 12px;color:var(--text-muted);font-weight:600;}
.keypoints ul{margin:0;padding-left:18px;}
.keypoints li{margin-bottom:8px;font-size:14.5px;}
.keypoints li:last-child{margin-bottom:0;}

/* quiz */
.quiz{margin-top:44px;border-top:1px solid var(--line);padding-top:34px;}
.quiz h3{font-family:var(--mono);font-size:18px;margin:0 0 4px;}
.quiz > p.hint{color:var(--text-muted);font-size:14px;margin:0 0 26px;}
.q-block{margin-bottom:30px;padding-bottom:26px;border-bottom:1px solid var(--line);}
.q-block:last-of-type{border-bottom:none;}
.q-prompt{font-weight:600;font-size:15.5px;margin:0 0 14px;}
.q-options{display:flex;flex-direction:column;gap:10px;}
.q-option{
  display:flex;align-items:flex-start;gap:10px;border:1px solid var(--line);border-radius:var(--radius);
  padding:12px 14px;font-size:14.5px;
}
.q-option input{margin-top:3px;accent-color:var(--signal);}
.q-option.correct{border-color:var(--signal);background:var(--signal-soft);}
.q-option.wrong{border-color:var(--danger);background:var(--danger-soft);}
.q-feedback{font-size:13.5px;margin-top:10px;color:var(--text-muted);display:none;}
.q-feedback.show{display:block;}
.quiz-actions{display:flex;align-items:center;gap:16px;margin-top:22px;flex-wrap:wrap;}
.quiz-score{font-family:var(--mono);font-size:13.5px;color:var(--text-muted);}
.complete-note{
  margin-top:20px;font-family:var(--mono);font-size:13.5px;color:var(--signal);display:none;
}
.complete-note.show{display:block;}

/* ---------- PROGRESS PAGE ---------- */
.progress-summary{
  border:1px solid var(--line);border-radius:var(--radius);padding:28px;margin-bottom:36px;
  display:flex;align-items:center;gap:30px;flex-wrap:wrap;
}
.progress-ring{flex:0 0 auto;}
.progress-num{font-family:var(--mono);font-size:34px;font-weight:600;}
.progress-label{color:var(--text-muted);font-size:14px;margin-top:4px;}
.progress-bar-track{flex:1;min-width:180px;height:6px;background:var(--paper-2);border-radius:4px;overflow:hidden;}
.progress-bar-fill{height:100%;background:var(--signal);width:0%;transition:width .3s ease;}
.progress-list{border-top:1px solid var(--line);}
.progress-row{
  display:flex;align-items:center;justify-content:space-between;padding:16px 0;border-bottom:1px solid var(--line);
}
.progress-row .left{display:flex;align-items:center;gap:14px;}
.progress-row .mark{
  width:22px;height:22px;border-radius:50%;border:1px solid var(--line-strong);flex:0 0 auto;
  display:flex;align-items:center;justify-content:center;font-size:11px;
}
.progress-row .mark.done{background:var(--signal);border-color:var(--signal);color:#fff;}
.progress-row span.title{font-size:14.5px;}
.progress-row span.status{font-family:var(--mono);font-size:12.5px;color:var(--text-muted);}
.reset-row{margin-top:26px;}
.reset-btn{
  font-family:var(--mono);font-size:13px;background:none;border:1px solid var(--line-strong);
  border-radius:var(--radius);padding:9px 16px;color:var(--text-muted);
}
.reset-btn:hover{border-color:var(--danger);color:var(--danger);}

/* ---------- SEARCH ---------- */
.search-row{margin-bottom:32px;}
.search-row input{
  width:100%;font-family:var(--mono);font-size:14.5px;padding:13px 16px;
  border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--paper);color:var(--text);
}
.search-row input:focus{outline:none;border-color:var(--signal);}
.search-empty{
  font-family:var(--mono);font-size:14px;color:var(--text-muted);padding:30px 0;text-align:center;
  border:1px dashed var(--line);border-radius:var(--radius);
}

/* ---------- BADGES ---------- */
.badges-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;margin-top:6px;}
.badge-card{
  border:1px solid var(--line);border-radius:var(--radius);padding:18px;
  display:flex;flex-direction:column;gap:10px;background:var(--paper);
}
.badge-card.locked{opacity:.45;}
.badge-card .badge-icon{
  width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  border:1px solid var(--line-strong);color:var(--text-muted);
}
.badge-card.unlocked .badge-icon{background:var(--signal);border-color:var(--signal);color:#fff;}
.badge-card h4{font-family:var(--mono);font-size:14px;margin:0;font-weight:600;}
.badge-card p{font-size:13px;color:var(--text-muted);margin:0;}

/* ---------- CERTIFICATE TEASER ---------- */
.cert-teaser{
  margin-top:48px;border:1px solid var(--line);border-radius:var(--radius);padding:28px;
  background:var(--paper-2);
}
.cert-teaser h3{font-family:var(--mono);font-size:16px;margin:0 0 8px;}
.cert-teaser p{color:var(--text-muted);font-size:14px;margin:0 0 18px;max-width:52ch;}
.cert-form{display:flex;gap:12px;flex-wrap:wrap;align-items:center;}
.cert-form input{
  font-family:var(--mono);font-size:14px;padding:11px 14px;border:1px solid var(--line-strong);
  border-radius:var(--radius);background:var(--paper);color:var(--text);flex:1;min-width:200px;
}
.cert-form input:focus{outline:none;border-color:var(--signal);}
.cert-locked-note{font-family:var(--mono);font-size:13px;color:var(--text-muted);}

/* ---------- CERTIFICATE PAGE ---------- */
.cert-wrap{max-width:760px;margin:0 auto;}
.cert-actions{display:flex;gap:14px;margin-bottom:30px;}
.certificate{
  border:2px solid var(--ink);border-radius:2px;padding:64px 56px;position:relative;background:var(--paper);
}
.certificate::before{
  content:'';position:absolute;inset:14px;border:1px solid var(--line-strong);pointer-events:none;
}
.cert-eyebrow{font-family:var(--mono);font-size:12.5px;color:var(--text-muted);text-align:center;margin:0 0 26px;}
.cert-heading{font-family:var(--mono);font-size:28px;font-weight:600;text-align:center;margin:0 0 6px;}
.cert-sub{text-align:center;color:var(--text-muted);font-size:14px;margin:0 0 40px;}
.cert-name{
  font-family:var(--mono);font-size:32px;text-align:center;font-weight:600;margin:0 0 8px;
  border-bottom:1px solid var(--line-strong);padding-bottom:16px;
}
.cert-line{text-align:center;color:var(--text-muted);font-size:14px;margin:0 0 44px;}
.cert-foot{display:flex;justify-content:space-between;align-items:flex-end;margin-top:20px;}
.cert-foot .sig{font-family:var(--mono);font-size:13px;color:var(--text-muted);border-top:1px solid var(--line-strong);padding-top:8px;min-width:160px;text-align:center;}
.cert-fine{margin-top:34px;font-size:12px;color:var(--text-muted);text-align:center;}
@media print{
  header.site, footer.site, .cert-actions, .back-btn{display:none !important;}
  body{background:#fff;}
  .certificate{border-color:#000;}
}

/* ---------- RISK TEST ---------- */
.risk-intro{max-width:62ch;margin-bottom:34px;}
.risk-intro p{font-size:15.5px;color:var(--text-muted);margin:0 0 18px;}
.risk-result{border:1px solid var(--line);border-radius:var(--radius);padding:30px;margin-top:8px;}
.risk-result-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:18px;}
.risk-score{font-family:var(--mono);font-size:30px;font-weight:600;}
.risk-level-tag{font-family:var(--mono);font-size:12.5px;padding:5px 12px;border-radius:20px;display:inline-block;}
.risk-level-tag.low{background:var(--signal-soft);color:var(--signal);}
.risk-level-tag.medium{background:var(--amber-soft);color:var(--amber);}
.risk-level-tag.high{background:var(--danger-soft);color:var(--danger);}
.risk-gauge-track{height:8px;background:var(--paper-2);border-radius:6px;overflow:hidden;margin:6px 0 24px;}
.risk-gauge-fill{height:100%;border-radius:6px;transition:width .4s ease;}
.risk-gauge-fill.low{background:var(--signal);}
.risk-gauge-fill.medium{background:var(--amber);}
.risk-gauge-fill.high{background:var(--danger);}
.risk-result p.summary{font-size:15px;color:var(--text-muted);margin:0 0 24px;max-width:56ch;}
.weak-list-head{font-family:var(--mono);font-size:13px;color:var(--text-muted);margin:0 0 14px;}
.risk-actions{display:flex;gap:14px;margin-top:26px;flex-wrap:wrap;}

/* ---------- SCENARIOS ---------- */
.scenario-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px;}
.scenario-card{
  border:1px solid var(--line);border-radius:var(--radius);padding:22px;display:flex;flex-direction:column;gap:12px;
  text-align:left;background:var(--paper);
}
.scenario-card:hover{border-color:var(--line-strong);}
.scenario-card svg{width:24px;height:24px;color:var(--text-muted);}
.scenario-card h3{font-family:var(--mono);font-size:15.5px;margin:0;font-weight:600;}
.scenario-card p{font-size:13.5px;color:var(--text-muted);margin:0;flex:1;}
.scenario-card .tag{font-family:var(--mono);font-size:11px;color:var(--text-muted);letter-spacing:.02em;}
.scenario-status{font-family:var(--mono);font-size:12px;color:var(--text-muted);}
.scenario-status.done{color:var(--signal);}

.mock-email{border:1px solid var(--line-strong);border-radius:var(--radius);overflow:hidden;margin:26px 0;}
.mock-email .row{padding:10px 16px;border-bottom:1px solid var(--line);font-family:var(--mono);font-size:12.5px;color:var(--text-muted);}
.mock-email .row b{color:var(--text);font-weight:600;}
.mock-email .body{padding:18px 16px;font-size:14.5px;line-height:1.65;}
.mock-email .fake-link{color:var(--signal);text-decoration:underline;font-family:var(--mono);font-size:13px;}

.mock-call{
  border:1px solid var(--line-strong);border-radius:var(--radius);padding:20px;margin:26px 0;
  background:var(--paper-2);display:flex;gap:14px;align-items:flex-start;
}
.mock-call svg{width:26px;height:26px;color:var(--text-muted);flex:0 0 auto;margin-top:2px;}
.mock-call p{margin:0;font-size:14.5px;font-style:italic;}

.mock-generic{border:1px solid var(--line-strong);border-radius:var(--radius);padding:20px;margin:26px 0;background:var(--paper-2);font-size:14.5px;display:flex;gap:14px;}
.mock-generic svg{width:26px;height:26px;color:var(--text-muted);flex:0 0 auto;margin-top:2px;}

.mock-app{border:1px solid var(--line-strong);border-radius:var(--radius);margin:26px 0;max-width:320px;}
.mock-app .head{padding:13px 16px;border-bottom:1px solid var(--line);font-family:var(--mono);font-size:13px;font-weight:600;}
.mock-app ul{margin:0;padding:6px 16px;list-style:none;}
.mock-app li{display:flex;justify-content:space-between;padding:9px 0;font-size:13px;border-bottom:1px solid var(--line);}
.mock-app li:last-child{border-bottom:none;}

.choice-list{display:flex;flex-direction:column;gap:10px;margin-top:8px;}
.choice-btn{
  text-align:left;border:1px solid var(--line-strong);border-radius:var(--radius);padding:14px 16px;
  background:var(--paper);font-size:14.5px;color:var(--text);
}
.choice-btn:hover:not(:disabled){background:var(--paper-2);}
.choice-btn:disabled{opacity:.55;cursor:default;}

.outcome-panel{margin-top:26px;border-radius:var(--radius);padding:20px 22px;border:1px solid var(--line);}
.outcome-panel.good{border-color:var(--signal);background:var(--signal-soft);}
.outcome-panel.ok{border-color:var(--amber);background:var(--amber-soft);}
.outcome-panel.bad{border-color:var(--danger);background:var(--danger-soft);}
.outcome-tag{font-family:var(--mono);font-size:12px;font-weight:600;margin-bottom:10px;display:block;}
